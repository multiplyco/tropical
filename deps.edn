{:paths         ["src" "resources" "target/classes"]

 ;; The signal and stream primitives are Java, next to the Clojure sources in
 ;; src. A git dependency compiles them on prep (`clj -X:deps prep`); the jar
 ;; ships them compiled.
 :deps/prep-lib {:alias  :build
                 :fn     compile-java
                 :ensure "target/classes"}

 :deps          {dev.onionpancakes/chassis            {:mvn/version "1.0.365"}
                 com.s-exp/oda                        {:mvn/version "1.0.0-alpha41"}
                 org.ring-clojure/ring-core-protocols {:mvn/version "1.15.5"}
                 co.multiply/quiescent                {:mvn/version "0.11.5"}
                 co.multiply/conc                     {:mvn/version "0.1.3"}
                 co.multiply/scoped                   {:mvn/version "0.1.18"}
                 org.clojure/tools.logging            {:mvn/version "1.3.1"}

                 ;; Provided by the consumer.
                 #_#_org.clojure/clojure {:mvn/version "1.12.6"}}

 :aliases
 {;; The demo page, served by `bb dev`. Not part of the library. Its server is
  ;; a typical production stack: Jetty 12 with sync handlers on virtual threads,
  ;; Ring's middleware, and a nonce-based CSP.
  :dev      {:extra-paths ["dev"]
             :extra-deps  {org.clojure/clojure            {:mvn/version "1.12.6"}
                           info.sunng/ring-jetty9-adapter {:mvn/version "0.40.4"}
                           ring/ring-core                 {:mvn/version "1.15.5"}
                           metosin/reitit                 {:mvn/version "0.10.1"}
                           toyokumo/ring-middleware-csp   {:mvn/version "0.4.63"}
                           io.github.tonsky/clj-reload    {:mvn/version "1.0.0"}
                           nrepl/nrepl                    {:mvn/version "1.7.0"}
                           cider/cider-nrepl              {:mvn/version "0.62.2"}
                           co.multiply/remontoire         {:mvn/version "0.7.4"}
                           ;; A logging backend for tools.logging, which would
                           ;; otherwise find slf4j without one and log nothing.
                           org.slf4j/slf4j-simple         {:mvn/version "2.0.19"}}
             :jvm-opts    ["-Djdk.attach.allowAttachSelf"
                           "-Dorg.slf4j.simpleLogger.log.co.multiply.tropical=debug"
                           ;; The compression libraries call native code.
                           "--enable-native-access=ALL-UNNAMED"]}

  ;; With `:dev`, for `bb dev:readable`: the browser sees the app's names as
  ;; written (`co.multiply.tropical.names`), for debugging.
  :readable {:jvm-opts ["-Dco.multiply.tropical.readable-names=true"]}

  :test     {:extra-paths ["test"]
             :extra-deps  {org.clojure/clojure       {:mvn/version "1.12.6"}
                           lambdaisland/kaocha       {:mvn/version "1.91.1392"}
                           org.slf4j/slf4j-simple    {:mvn/version "2.0.19"}
                           ;; Independent decoders, for what the encoders write:
                           ;; zstd's, and brotli's in pure Java.
                           com.github.luben/zstd-jni {:mvn/version "1.5.7-22"}
                           org.brotli/dec            {:mvn/version "0.1.2"}}
             ;; Tests run on platform threads and deref Quiescent tasks at their
             ;; assertions, which machine-latch's virtual-thread assertion refuses.
             :jvm-opts    ["-Dco.multiply.machine-latch.assert-virtual=false"
                           "--enable-native-access=ALL-UNNAMED"]
             :main-opts   ["-m" "kaocha.runner"]}

  :build    {:ns-default build
             :deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                          slipset/deps-deploy           {:mvn/version "0.2.5"}}}

  :cljdoc   {:extra-deps {io.github.cljdoc/cljdoc-analyzer {:git/tag "v1.0.873" :git/sha "bf4f620c"}}
             :main-opts  ["-m" "cljdoc-analyzer.cljdoc-main"]}}}
